# Backend API base URL — leave empty for same-origin or Vite proxy (dev).
# In production set this to your backend origin, e.g. https://api.yourapp.com
VITE_API_BASE_URL=

# LINE OAuth — client_id is safe to expose (public identifier)
VITE_LINE_CLIENT_ID=
VITE_LINE_REDIRECT_URI=http://localhost:5173/line-callback

# DO NOT add server-side secrets (Anthropic keys, DB passwords, etc.) here.
# VITE_ variables are bundled into the browser build and visible to all users.
# All AI/backend secrets must live in your server's environment only.
